# Virtual environments
.venv/
venv/
ENV/
env/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Git & IDEs
.git/
.gitignore
.idea/
.vscode/
*.swp
*.swo

# MLflow & Prefect local runs and databases
mlruns/
mlflow.db
.prefect/

# Feast local online db / data artifacts if generated dynamically
features/data/
*.parquet
*.db
*.sqlite

# Large temporary datasets & logs
data/raw/
data/processed/
data/monitoring/reports/*.html
logs/
*.log

# Trained model weights are bind-mounted at runtime (see docker-compose.yml), never baked in
models/

# Frontend is built/served separately; node_modules alone is 100MB+
frontend/

# Docs, agent configs, and tests are not needed inside the image
*.md
.agents/
.claude/
tests/
bentofile.yaml
